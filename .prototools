# Tool versions for this repository. Install them all with `proto install`.
# Exact versions only; one tool per line, sorted by name.
#
# proto installs Rust through rustup and does not shim cargo, so rustup selects the toolchain
# from `rust-toolchain.toml`. Change `rust` here and `channel` there together;
# `cargo test -p repo-check` fails when they differ.
#
# Renovate (renovate.json5) updates these pins. It knows `bun` and `rust` by itself; every
# tool with a schema plugin needs the `# renovate:` comment above its pin (datasource and the
# upstream repository, plus `extractVersion` when release tags carry a `v` prefix).

# renovate: datasource=github-releases depName=rhysd/actionlint extractVersion=^v(?<version>.+)$
actionlint = "1.7.12"
bun = "1.4.2"
# renovate: datasource=github-releases depName=rust-secure-code/cargo-auditable extractVersion=^v(?<version>.+)$
cargo-auditable = "0.7.6"
# renovate: datasource=github-releases depName=EmbarkStudios/cargo-deny
cargo-deny = "0.20.2"
# renovate: datasource=github-releases depName=rust-cross/cargo-zigbuild extractVersion=^v(?<version>.+)$
cargo-zigbuild = "0.23.4"
# renovate: datasource=github-releases depName=sigstore/cosign extractVersion=^v(?<version>.+)$
cosign = "3.1.3"
# renovate: datasource=github-releases depName=gitleaks/gitleaks extractVersion=^v(?<version>.+)$
gitleaks = "8.30.1"
# renovate: datasource=github-releases depName=helm/helm extractVersion=^v(?<version>.+)$
helm = "4.3.0"
# renovate: datasource=github-releases depName=k3d-io/k3d extractVersion=^v(?<version>.+)$
k3d = "5.9.0"
# renovate: datasource=github-releases depName=yannh/kubeconform extractVersion=^v(?<version>.+)$
kubeconform = "0.8.0"
# renovate: datasource=github-tags depName=kubernetes/kubernetes extractVersion=^v(?<version>.+)$
kubectl = "1.36.5"
rust = "1.99.0"
# renovate: datasource=github-releases depName=anchore/syft extractVersion=^v(?<version>.+)$
syft = "1.52.0"
# Zig is developed on Codeberg (its GitHub repository has no tags after 0.15.2), so Renovate
# reads the tags of the Codeberg repository with git.
# renovate: datasource=git-tags depName=https://codeberg.org/ziglang/zig
zig = "0.16.0"

# Tools without a built-in proto plugin. Each schema downloads the official release
# archive or binary and verifies it against the checksum file published with the release
# (Zig: against the release's minisign signature).
[plugins.tools]
actionlint = "file://./.proto/plugins/actionlint.toml"
cargo-auditable = "file://./.proto/plugins/cargo-auditable.toml"
cargo-deny = "file://./.proto/plugins/cargo-deny.toml"
cargo-zigbuild = "file://./.proto/plugins/cargo-zigbuild.toml"
cosign = "file://./.proto/plugins/cosign.toml"
gitleaks = "file://./.proto/plugins/gitleaks.toml"
helm = "file://./.proto/plugins/helm.toml"
k3d = "file://./.proto/plugins/k3d.toml"
kubeconform = "file://./.proto/plugins/kubeconform.toml"
kubectl = "file://./.proto/plugins/kubectl.toml"
syft = "file://./.proto/plugins/syft.toml"
zig = "file://./.proto/plugins/zig.toml"
