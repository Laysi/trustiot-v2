#!/bin/bash
# TrustIoT gateway image (edge/image, Laysi/trustiot-v2#810): the data partition's LUKS2 volume.
# Installed as /usr/libexec/trustiot/trustiot-data-setup and run by trustiot-data-setup.service at
# every boot, before systemd-cryptsetup@trustiot_data.service unlocks the volume with the TPM
# (edge/image/README.md, section 「資料分割區加密」).
#
# On the first boot the partition is still all zeros: this script encrypts it with a key the
# gateway generates, enrolls this gateway's TPM (no PCRs), makes the agent's file system inside,
# and wipes the key's own keyslot, so only the TPM opens the volume and no person ever holds a
# key. On every later boot it checks that the volume is still that one, with the TPM as its only
# keyslot, and that the TPM opens it. Anything it does not recognise is refused, never formatted:
# the unit fails, the volume stays locked, the data partition is not mounted and the agent does
# not start (fail closed). It never asks for a password.
#
# The one exception (Laysi/trustiot-v2#867; README.md, section 「TPM 永久解不開時」): when the TPM
# cannot open the volume, its owner hierarchy is no longer the one the volume was sealed under
# (another TPM, or this one cleared) and it holds no key besides the storage key (so it is not
# another registered gateway's TPM, which a card moved from gateway to gateway would meet), no TPM
# will ever open the volume again and this TPM has to go back to the factory anyway. The volume is
# then wiped and made anew for this TPM, and its header carries a mark that the gateway goes back
# to the factory; the agent stays off while the mark is there. Whatever is less certain (no TPM, a
# TPM that does not answer, the same owner hierarchy, a TPM that holds keys, a volume without the
# record) is never a reason to wipe.
set -euo pipefail
umask 077
export LC_ALL=C
# tpm2-tools talk to the kernel's resource manager, never to a daemon or the raw device.
export TPM2TOOLS_TCTI=device:/dev/tpmrm0

# Where the image puts the partition (edge/image/src/pins.ts and src/layout.ts; the image tests
# compare these lines with them).
readonly PART_NUMBER=3
readonly PART_START=1064960
readonly PART_SECTORS=4194304
readonly LUKS_UUID=9da7f680-5912-4d5c-bca6-d46c83e064f8
# The LUKS2 label says how far the setup got: "new" until the file system is made and the key's
# keyslot is wiped, the final label after that. Only a "new" volume is ever formatted again.
readonly LABEL_NEW=trustiot-data-new
readonly LABEL_READY=trustiot-data
readonly FS_LABEL=trustiot-data
readonly AGENT_USER=trustiot-agent
# The LUKS2 header lies in the first 16 MiB (the data starts behind it): two copies of the
# metadata, METADATA_BYTES each, then the keyslot area. These are cryptsetup's defaults for this
# volume, given explicitly because the header is made in a file first (format()).
readonly HEADER_BYTES=16777216
readonly METADATA_BYTES=16384
readonly SETUP_MAPPING=trustiot_data_setup
# Two LUKS2 tokens of the setup's own, without keyslots (systemd-cryptsetup and cryptsetup ignore
# token types they have no plugin for): the fingerprint of the TPM's owner hierarchy the volume
# was sealed under, and the mark that the gateway goes back to the factory.
readonly OWNER_TOKEN_ID=1
readonly OWNER_TOKEN_TYPE=trustiot-tpm-owner
readonly MARK_TOKEN_ID=2
readonly MARK_TOKEN_TYPE=trustiot-back-to-factory
# While the header carries the mark, this file keeps the agent from starting
# (ConditionPathExists=! in trustiot-agent-data.conf).
readonly FACTORY_FLAG=/run/trustiot-back-to-factory
# How the setup looks at a TPM that does not open the volume: every CHECK_INTERVAL_S seconds, the
# last time at most CHECK_WINDOW_S seconds after the first; the same other owner hierarchy
# CHECK_SAME_ANSWERS times in a row is permanent. TPM_COMMAND_LIMIT_S bounds each TPM command.
readonly CHECK_INTERVAL_S=10
readonly CHECK_WINDOW_S=180
readonly CHECK_SAME_ANSWERS=3
readonly TPM_COMMAND_LIMIT_S=60

log() { printf '%s\n' "$*" >&2; }
# A warning in the journal (priority 4: systemd reads the <4> prefix of a line on stderr).
warn() { printf '<4>%s\n' "$*" >&2; }
die() {
	log "refusing: $*"
	exit 1
}

# The partition by its place: entry 3 of the disk the root file system is on, at the start and
# size the image gives it. It is never looked up by a label or UUID that another disk could carry.
data_partition() {
	local majmin sys disk child
	majmin=$(findmnt --noheadings --output MAJ:MIN --mountpoint /) || die "cannot find the root file system's device"
	majmin=${majmin//[[:space:]]/}
	sys=$(readlink -f "/sys/dev/block/$majmin") || die "no block device $majmin"
	[[ -f $sys/partition ]] || die "the root file system ($majmin) is not on a partition"
	disk=${sys%/*}
	for child in "$disk"/*/; do
		child=${child%/}
		[[ -f $child/partition && $(<"$child/partition") == "$PART_NUMBER" ]] || continue
		if [[ $(<"$child/start") != "$PART_START" || $(<"$child/size") != "$PART_SECTORS" ]]; then
			die "partition $PART_NUMBER of ${disk##*/} is at sector $(<"$child/start") with $(<"$child/size") sectors, expected $PART_START and $PART_SECTORS"
		fi
		printf '/dev/%s\n' "${child##*/}"
		return 0
	done
	die "${disk##*/} has no partition $PART_NUMBER"
}

# One `blkid -p` field of the partition (empty when blkid finds nothing there).
probe() {
	local dev=$1 field=$2 out code=0
	out=$(blkid --probe --output export "$dev") || code=$?
	# 2: nothing found; anything else but 0 is an error.
	if ((code == 2)); then return 0; fi
	((code == 0)) || die "blkid -p $dev exited with $code"
	sed -n "s/^$field=//p" <<<"$out"
}

# Exactly one keyslot, and the TPM's: systemd-cryptenroll lists every keyslot with the token type
# that uses it, and a keyslot no token uses as "password".
tpm_only() {
	local listing types
	listing=$(systemd-cryptenroll "$1") || return 1
	types=$(awk 'NR > 1 && NF { print $2 }' <<<"$listing" | sort | paste -sd ' ')
	[[ $types == "tpm2" ]]
}

# Only the data partition may carry the volume's UUID: crypttab finds the volume by it.
unique_uuid() {
	local dev=$1 found
	udevadm settle --timeout=60 || true
	found=$(blkid --cache-file /dev/null --match-token "UUID=$LUKS_UUID" --output device | sort | paste -sd ' ')
	[[ $found == "$dev" ]] || die "the volume UUID $LUKS_UUID is on '$found', expected only $dev"
	[[ $(readlink -f "/dev/disk/by-uuid/$LUKS_UUID") == "$dev" ]] || die "/dev/disk/by-uuid/$LUKS_UUID does not point at $dev"
}

work=""
scratch=""
cleanup() {
	if [[ -e /dev/mapper/$SETUP_MAPPING ]]; then cryptsetup close "$SETUP_MAPPING" || true; fi
	if [[ -n $work ]]; then rm -rf -- "$work"; fi
	if [[ -n $scratch ]]; then rm -rf -- "$scratch"; fi
}

# The fingerprint of the TPM's owner hierarchy, in `dir`: the name (hex) of the primary key the
# TCG's standard ECC storage key template gives there, the template systemd-cryptenroll persists
# at 0x81000001. A primary key is derived from the hierarchy's seed, so the name stays the same for
# as long as the seed does: only TPM2_Clear replaces the owner seed, and another TPM has its own.
# The key is transient: the resource manager flushes it when tpm2_createprimary ends.
owner_fingerprint() {
	local dir=$1
	rm -f -- "$dir/owner.ctx" "$dir/owner.name"
	timeout "$TPM_COMMAND_LIMIT_S" tpm2_createprimary --hierarchy=o --hash-algorithm=sha256 --key-algorithm=ecc256:aes128cfb \
		--attributes='fixedtpm|fixedparent|sensitivedataorigin|userwithauth|noda|restricted|decrypt' \
		--key-context="$dir/owner.ctx" >/dev/null 2>&1 || return 1
	timeout "$TPM_COMMAND_LIMIT_S" tpm2_readpublic --object-context="$dir/owner.ctx" --name="$dir/owner.name" >/dev/null 2>&1 || return 1
	name_hex "$dir/owner.name"
}

# The name of the storage key systemd-cryptenroll persisted at 0x81000001, when one is there.
srk_name() {
	local dir=$1
	rm -f -- "$dir/srk.name"
	timeout "$TPM_COMMAND_LIMIT_S" tpm2_readpublic --object-context=0x81000001 --name="$dir/srk.name" >/dev/null 2>&1 || return 1
	name_hex "$dir/srk.name"
}

# A TPM2B name file as hex: a SHA-256 name, the algorithm (000b) and 32 bytes.
name_hex() {
	local hex
	hex=$(od -An -tx1 -v "$1" | tr -d ' \n')
	[[ $hex =~ ^000b[0-9a-f]{64}$ ]] || return 1
	printf '%s\n' "$hex"
}

# One string field of a token (`cryptsetup token export`): its value when it matches `pattern`
# whole; prints nothing and fails otherwise. The header is not authenticated (whoever can write the
# partition can write it), so nothing read from it is ever printed or used unchecked.
token_field() {
	local json=$1 field=$2 pattern=$3 value
	local re="[{,][[:space:]]*\"$field\"[[:space:]]*:[[:space:]]*\"([^\"\\\\]*)\"[[:space:]]*[,}]"
	[[ $json =~ $re ]] || return 1
	value=${BASH_REMATCH[1]}
	re="^($pattern)\$"
	[[ $value =~ $re ]] || return 1
	printf '%s\n' "$value"
}

# The token with this id, when it is of this type (one of the setup's own).
token_of_type() {
	local dev=$1 id=$2 type=$3 json
	json=$(cryptsetup token export --token-id "$id" "$dev" 2>/dev/null) || return 1
	[[ $(token_field "$json" type '[a-z0-9-]+') == "$type" ]] || return 1
	printf '%s\n' "$json"
}

# The fingerprint recorded when the TPM was enrolled (OWNER_TOKEN_ID), if there is one.
recorded_owner() {
	local json
	json=$(token_of_type "$1" "$OWNER_TOKEN_ID" "$OWNER_TOKEN_TYPE") || return 1
	token_field "$json" owner '000b[0-9a-f]{64}'
}

# The mark of a wipe as the setup writes it: why, and the owner hierarchies before and after.
make_mark() {
	printf '{"type":"%s","keyslots":[],"reason":"%s","sealed_owner":"%s","found_owner":"%s"}\n' "$MARK_TOKEN_TYPE" "$1" "$2" "$3"
}

# The fields of a mark (the token's JSON) in the globals mark_reason, mark_sealed and mark_found,
# each "unknown" when it is not what the setup writes.
mark_fields() {
	mark_reason=$(token_field "$1" reason '[a-z-]{1,40}') || mark_reason=unknown
	mark_sealed=$(token_field "$1" sealed_owner '000b[0-9a-f]{64}') || mark_sealed=unknown
	mark_found=$(token_field "$1" found_owner '000b[0-9a-f]{64}') || mark_found=unknown
}

# The mark in the header (MARK_TOKEN_ID), made again from the fields read back (mark_fields).
# Prints nothing when there is no mark.
read_mark() {
	local json
	json=$(token_of_type "$1" "$MARK_TOKEN_ID" "$MARK_TOKEN_TYPE") || return 0
	mark_fields "$json"
	make_mark "$mark_reason" "$mark_sealed" "$mark_found"
}

# One look at the TPM, in the global `answer` (README.md, section 「TPM 永久解不開時」):
#   opens                  the TPM unseals the volume's key (cryptsetup --test-passphrase: no mapping)
#   absent                 no /dev/tpmrm0
#   silent                 the TPM does not answer (tpm2_getcap fails or runs out of time)
#   unrecorded             the volume holds no fingerprint of the owner hierarchy it was sealed under
#   unknown-owner          the owner hierarchy's fingerprint cannot be made (an owner password, ...)
#   same-owner             the owner hierarchy is the recorded one: not a TPM change
#   unknown-keys           another owner hierarchy, but the TPM's persistent handles cannot be read
#   keyed <handles>        another owner hierarchy, in a TPM that holds keys besides the storage key
#                          (most likely another registered gateway's TPM: the card was moved)
#   other-owner <name>     another owner hierarchy, in a TPM without keys: another TPM, or this one
#                          cleared
# Only the last one may ever lead to a wipe.
observe() {
	local dev=$1 recorded found srk keys
	if ! tpm_present; then
		answer=absent
	elif timeout "$TPM_COMMAND_LIMIT_S" cryptsetup open --test-passphrase --token-only --token-type systemd-tpm2 "$dev" >/dev/null 2>&1; then
		answer=opens
	elif ! timeout "$TPM_COMMAND_LIMIT_S" tpm2_getcap properties-variable >/dev/null 2>&1; then
		answer=silent
	elif ! recorded=$(recorded_owner "$dev"); then
		answer=unrecorded
	elif ! found=$(owner_fingerprint "$scratch"); then
		answer=unknown-owner
	elif [[ $found == "$recorded" ]]; then
		answer=same-owner
	elif srk=$(srk_name "$scratch") && [[ $srk == "$recorded" ]]; then
		# The storage key the volume was sealed under is still there: the template above no longer
		# gives the same key (a tool update), so its fingerprint proves nothing.
		answer=same-owner
	elif ! keys=$(owner_keys); then
		answer=unknown-keys
	elif [[ -n $keys ]]; then
		answer="keyed $keys"
	else
		answer="other-owner $found"
	fi
}

# The persistent objects of the owner and endorsement hierarchies (handles 0x81000000 to
# 0x817fffff) besides the storage key at 0x81000001, comma-separated; empty when there are none.
# The factory workstation persists the gateway's key there (factory/workstation, --handle),
# TPM2_Clear removes them all and a new TPM normally holds none, so a TPM that holds one is most
# likely another gateway's (and one that came with a key of its own is left alone too). The
# platform's own (0x81800000 and up) say nothing about that and survive TPM2_Clear. Fails when the
# TPM does not list its handles, or lists something that is not a handle.
owner_keys() {
	local out line handle keys=()
	out=$(timeout "$TPM_COMMAND_LIMIT_S" tpm2_getcap handles-persistent 2>/dev/null) || return 1
	while IFS= read -r line; do
		[[ -n $line ]] || continue
		[[ $line =~ ^-\ (0x[0-9a-fA-F]{8})$ ]] || return 1
		handle=${BASH_REMATCH[1],,}
		if [[ $handle =~ ^0x81[0-7] && $handle != 0x81000001 ]]; then keys+=("$handle"); fi
	done <<<"$out"
	local IFS=,
	printf '%s\n' "${keys[*]}"
}

tpm_present() { [[ -e /dev/tpmrm0 ]]; }
uptime_s() {
	local up
	read -r up _ </proc/uptime
	printf '%s\n' "${up%.*}"
}
pause() { sleep "$1"; }

# Looks at the TPM (observe) until it opens the volume, or the same other owner hierarchy has been
# seen CHECK_SAME_ANSWERS times in a row, or CHECK_WINDOW_S seconds have passed. Sets the global
# `verdict`: "opens", "permanent <found owner>" or "unsure <last answer>".
check_tpm() {
	local dev=$1 start last="" same=0 looks=0 elapsed
	start=$(uptime_s)
	while :; do
		elapsed=$(($(uptime_s) - start))
		looks=$((looks + 1))
		observe "$dev"
		log "the TPM (look $looks, $elapsed s): $answer"
		case $answer in
		opens)
			verdict=opens
			return 0
			;;
		other-owner\ *)
			if [[ $answer == "$last" ]]; then same=$((same + 1)); else same=1; fi
			;;
		*) same=0 ;;
		esac
		last=$answer
		if ((same >= CHECK_SAME_ANSWERS)); then
			verdict="permanent ${answer#other-owner }"
			return 0
		fi
		if (($(uptime_s) - start + CHECK_INTERVAL_S > CHECK_WINDOW_S)); then
			verdict="unsure $answer"
			return 0
		fi
		pause "$CHECK_INTERVAL_S"
	done
}

format() {
	local dev=$1 mark=$2 key header stand_in owner fingerprint
	[[ -e /dev/tpmrm0 ]] || die "no TPM (/dev/tpmrm0): the data partition stays unencrypted and unmounted"
	owner=$(getent passwd "$AGENT_USER" | cut -d: -f3,4)
	[[ $owner =~ ^[0-9]+:[0-9]+$ ]] || die "no $AGENT_USER account"
	# The key exists only on /run (memory), only until its keyslot is wiped below.
	work=$(mktemp -d /run/trustiot-data-setup.XXXXXXXX)
	key=$work/key
	head -c 48 /dev/random | base64 -w 0 >"$key"
	[[ $(stat -c %s "$key") == 64 ]] || die "could not read 48 random bytes"
	# The owner hierarchy the volume is sealed under below, recorded in the header: a later boot
	# tells another TPM, or this one cleared, from one that only fails to answer by it.
	fingerprint=$(owner_fingerprint "$work") || die "cannot read the TPM's owner hierarchy (tpm2_createprimary): not formatting"

	# A power cut must never leave the partition in a state main() refuses: whatever was there
	# before (all zeros, or the header of a setup that did not finish) stays until the new header,
	# labelled LABEL_NEW, replaces it. So the header is made in a file on /run first, then written
	# to the partition: its two metadata copies, then the keyslot area, each written through
	# (fsync) before the next. luksFormat on the partition itself would zero all 16 MiB, then fill
	# the keyslot area, and only then write the header: a power cut in between would leave no
	# header in front of the earlier attempt's ciphertext, or of the random keyslot area
	# (Laysi/trustiot-v2#917; edge/image/README.md, section 「斷電時」). The stand-in is a sparse
	# file of the partition's size: luksFormat needs a data device but writes nothing to it, and
	# the partition is never handed to it.
	header=$work/header
	stand_in=$work/stand-in
	truncate --size="$((PART_SECTORS * 512))" "$stand_in"
	log "encrypting $dev (LUKS2, aes-xts-plain64)"
	cryptsetup luksFormat --batch-mode --type luks2 --cipher aes-xts-plain64 --key-size 512 \
		--sector-size 4096 --hash sha256 --pbkdf pbkdf2 --pbkdf-force-iterations 1000 \
		--uuid "$LUKS_UUID" --label "$LABEL_NEW" --key-slot 0 --key-file "$key" \
		--header "$header" --offset "$((HEADER_BYTES / 512))" --luks2-metadata-size "$METADATA_BYTES" \
		--luks2-keyslots-size "$((HEADER_BYTES - 2 * METADATA_BYTES))" "$stand_in"
	rm -f -- "$stand_in"
	# The setup's tokens go into the header file, so they reach the partition with the header:
	# the fingerprint, and the mark of a wipe (Laysi/trustiot-v2#867), which every later header
	# of this partition carries on until the factory removes it.
	printf '{"type":"%s","keyslots":[],"owner":"%s"}\n' "$OWNER_TOKEN_TYPE" "$fingerprint" >"$work/owner.json"
	cryptsetup token import --token-id "$OWNER_TOKEN_ID" --json-file "$work/owner.json" "$header"
	if [[ -n $mark ]]; then
		printf '%s\n' "$mark" >"$work/mark.json"
		cryptsetup token import --token-id "$MARK_TOKEN_ID" --json-file "$work/mark.json" "$header"
	fi
	# What lands on the partition first must be what main() starts over from.
	[[ $(stat -c %s "$header") == "$HEADER_BYTES" ]] || die "the new LUKS2 header is $(stat -c %s "$header") bytes, expected $HEADER_BYTES"
	[[ $(probe "$header" TYPE) == crypto_LUKS && $(probe "$header" UUID) == "$LUKS_UUID" && $(probe "$header" LABEL) == "$LABEL_NEW" ]] ||
		die "the new LUKS2 header is not a $LABEL_NEW volume with the UUID $LUKS_UUID"
	# Each dd names its range, so neither ever writes past the header even without the check above.
	dd if="$header" of="$dev" bs="$((2 * METADATA_BYTES))" count=1 conv=notrunc,fsync status=none
	dd if="$header" of="$dev" bs="$((2 * METADATA_BYTES))" skip=1 seek=1 \
		count="$((HEADER_BYTES / (2 * METADATA_BYTES) - 1))" conv=notrunc,fsync status=none
	rm -f -- "$header"

	log "enrolling this gateway's TPM (no PCRs)"
	systemd-cryptenroll --unlock-key-file="$key" --tpm2-device=auto --tpm2-pcrs= \
		--tpm2-public-key= --tpm2-pcrlock= --tpm2-with-pin=no "$dev"

	# Opened through the TPM token, the way systemd-cryptsetup opens it at every boot.
	cryptsetup open --token-only --token-type systemd-tpm2 "$dev" "$SETUP_MAPPING"
	mke2fs -t ext4 -q -F -L "$FS_LABEL" -m 0 -E "root_owner=$owner,nodiscard" "/dev/mapper/$SETUP_MAPPING"
	debugfs -w -R "set_inode_field <2> mode 040700" "/dev/mapper/$SETUP_MAPPING" >/dev/null
	e2fsck -f -n "/dev/mapper/$SETUP_MAPPING" >/dev/null
	cryptsetup close "$SETUP_MAPPING"

	log "wiping the key's keyslot: from now on only this TPM opens the volume"
	# Batch mode removes the key slot without asking for a remaining passphrase (cryptsetup-luksKillSlot(8):
	# "Except running in batch-mode (-q), a remaining passphrase must be supplied", read 2026-10-31 at
	# https://man7.org/linux/man-pages/man8/cryptsetup-luksKillSlot.8.html); stdin is empty, so it
	# never waits for one. Tried with cryptsetup 2.7.5 on 2026-10-31: it logs "Nothing to read on
	# input.", the slot goes, exit 0 (the boot test's first boot shows it in the journal).
	cryptsetup luksKillSlot --batch-mode "$dev" 0 </dev/null
	rm -rf -- "$work"
	work=""
	tpm_only "$dev" || die "$dev has keyslots other than the TPM's after the setup"
	cryptsetup config --label "$LABEL_READY" "$dev"
	udevadm trigger --settle --action=change "$dev"
	log "done: $dev is encrypted and opens only with this gateway's TPM"
}

# A volume the TPM did not open: wiped when the owner hierarchy it was sealed under is gone for
# good, left locked otherwise (README.md, section 「TPM 永久解不開時」).
check_or_wipe() {
	local dev=$1 recorded found
	check_tpm "$dev"
	case $verdict in
	opens)
		log "$dev is encrypted and opens only with the TPM"
		;;
	permanent\ *)
		found=${verdict#permanent }
		recorded=$(recorded_owner "$dev") || recorded=unknown
		warn "the TPM's owner hierarchy is $found, the volume was sealed under $recorded: another TPM, or this one cleared; no TPM can open it again"
		warn "wiping $dev and making it anew for this TPM; the gateway goes back to the factory to be registered again"
		format "$dev" "$(make_mark tpm-owner-changed "$recorded" "$found")"
		;;
	*)
		warn "the TPM did not open $dev within ${CHECK_WINDOW_S} s (last: ${verdict#unsure }); not wiping it: it stays locked"
		if [[ $verdict == "unsure keyed "* ]]; then
			warn "this TPM holds keys (${verdict#unsure keyed }) but is not the one the volume was sealed under: most likely another gateway's TPM, so this card is not this gateway's own"
		fi
		;;
	esac
}

# Every boot: when the header carries the mark of a wipe, say so in the journal and leave
# FACTORY_FLAG, which keeps the agent off until the factory removes the mark.
announce_mark() {
	local dev=$1 json
	rm -f -- "$FACTORY_FLAG"
	json=$(token_of_type "$dev" "$MARK_TOKEN_ID" "$MARK_TOKEN_TYPE") || return 0
	mark_fields "$json"
	warn "$dev was wiped ($mark_reason) and carries the mark to go back to the factory: the agent stays off until the factory registers the gateway again and removes the mark (README.md, section 「TPM 永久解不開時」)"
	printf 'reason=%s\nsealed_owner=%s\nfound_owner=%s\n' "$mark_reason" "$mark_sealed" "$mark_found" >"$FACTORY_FLAG.new"
	chmod 0644 "$FACTORY_FLAG.new"
	mv -f -- "$FACTORY_FLAG.new" "$FACTORY_FLAG"
}

main() {
	local dev type uuid label
	trap cleanup EXIT
	scratch=$(mktemp -d /run/trustiot-data-setup.XXXXXXXX)
	dev=$(data_partition)
	type=$(probe "$dev" TYPE)
	uuid=$(probe "$dev" UUID)
	label=$(probe "$dev" LABEL)
	if [[ -z $type ]]; then
		# Never used only when every byte is zero (read once, on the first boot): whatever else is
		# there, even after 16 MiB of zeros, may be someone's data.
		cmp --silent --bytes="$((PART_SECTORS * 512))" "$dev" /dev/zero || die "$dev has no known format but is not empty; not formatting it"
		log "$dev is empty: first boot"
		format "$dev" ""
	elif [[ $type == crypto_LUKS && $uuid == "$LUKS_UUID" && $label == "$LABEL_NEW" ]]; then
		log "$dev holds a setup that did not finish (no data was ever written to it): starting again"
		# A wipe that did not finish: its mark is in the new header, and stays in the next one.
		format "$dev" "$(read_mark "$dev")"
	elif [[ $type == crypto_LUKS && $uuid == "$LUKS_UUID" && $label == "$LABEL_READY" ]]; then
		tpm_only "$dev" || die "$dev has a keyslot other than the TPM's"
		# Before anything may wipe it: crypttab must find this volume and no other.
		unique_uuid "$dev"
		check_or_wipe "$dev"
	else
		die "$dev holds ${type:-unknown} (UUID ${uuid:-none}, label ${label:-none}), not this image's data volume; not formatting it"
	fi
	unique_uuid "$dev"
	announce_mark "$dev"
