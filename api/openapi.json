{
  "components": {
    "schemas": {
      "AssetsTenant": {
        "description": "The caller's tenant as this service knows it.",
        "properties": {
          "created_at": {
            "description": "When this service learned of the tenant, by the database clock.",
            "format": "date-time",
            "type": "string"
          },
          "tenant_id": {
            "$ref": "#/components/schemas/TenantId",
            "description": "The tenant's ID."
          }
        },
        "required": [
          "tenant_id",
          "created_at"
        ],
        "type": "object"
      },
      "CreateTenant": {
        "description": "The body of `POST /api/identity/v1/tenants`. Unknown fields are ignored.",
        "properties": {
          "name": {
            "description": "What people call the tenant: 1 to 100 characters after trimming, without control or\nformat characters or line and paragraph separators.",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "ErrorBody": {
        "description": "The JSON body of every error response (M1). Clients ignore fields they do not know, so\nfields are only ever added as optional ones.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode",
            "description": "What went wrong; clients branch on this."
          },
          "details": {
            "description": "Values the translated message refers to, for example `{\"max\": 40}`. Never user-facing\ntext, internal error text, or personal data. Absent when empty.",
            "type": "object"
          },
          "field_errors": {
            "description": "The request fields that were rejected. Absent when empty.",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
          "message_key": {
            "$ref": "#/components/schemas/MessageKey",
            "description": "The message the client shows, translated by the client."
          }
        },
        "required": [
          "code",
          "message_key"
        ],
        "type": "object"
      },
      "ErrorCode": {
        "description": "What went wrong, as one of a closed set of codes (M1). The HTTP status follows from the\ncode; a more specific reason goes in the message key, not in a new code.",
        "enum": [
          "invalid_request",
          "validation_failed",
          "unauthenticated",
          "permission_denied",
          "tenant_suspended",
          "quota_exceeded",
          "not_found",
          "conflict",
          "rate_limited",
          "internal",
          "unavailable",
          "timeout"
        ],
        "type": "string"
      },
      "EventId": {
        "description": "An event, unique across services; consumers deduplicate deliveries by it.\n\nSerialized as a lowercase hyphenated UUID string.",
        "format": "uuid",
        "type": "string"
      },
      "EventLogPage": {
        "description": "One page of the log, newest first.",
        "properties": {
          "events": {
            "description": "The events, newest first (by `occurred_at`, then `event_id`).",
            "items": {
              "$ref": "#/components/schemas/LoggedEvent"
            },
            "type": "array"
          },
          "next_cursor": {
            "description": "Pass it as `cursor` for the next, older page; `null` on the last page. Opaque.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "events"
        ],
        "type": "object"
      },
      "FieldError": {
        "description": "A rejected field of the request body.",
        "properties": {
          "details": {
            "description": "Values the message refers to. Absent when empty.",
            "type": "object"
          },
          "field": {
            "description": "JSON Pointer (RFC 6901) to the rejected value in the request body, for example\n`/points/3/address`; an empty string means the whole body.",
            "type": "string"
          },
          "message_key": {
            "$ref": "#/components/schemas/MessageKey",
            "description": "The message the client shows next to the field."
          }
        },
        "required": [
          "field",
          "message_key"
        ],
        "type": "object"
      },
      "LoggedActor": {
        "description": "Who made a logged change.",
        "oneOf": [
          {
            "description": "A person, through the API (a platform administrator too).",
            "properties": {
              "kind": {
                "enum": [
                  "user"
                ],
                "type": "string"
              },
              "user_id": {
                "$ref": "#/components/schemas/UserId",
                "description": "The user."
              }
            },
            "required": [
              "user_id",
              "kind"
            ],
            "type": "object"
          },
          {
            "description": "A service's own work, such as a scheduled job.",
            "properties": {
              "kind": {
                "enum": [
                  "service"
                ],
                "type": "string"
              },
              "service": {
                "description": "The service, for example `assets`.",
                "type": "string"
              }
            },
            "required": [
              "service",
              "kind"
            ],
            "type": "object"
          }
        ]
      },
      "LoggedEvent": {
        "description": "One event in the log.",
        "properties": {
          "actor": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/LoggedActor",
                "description": "Who made the change; `null` when the producer did not say."
              },
              {
                "type": "null"
              }
            ]
          },
          "aggregate_id": {
            "description": "What changed: the aggregate's ID.",
            "type": "string"
          },
          "aggregate_seq": {
            "description": "The event's number within its aggregate, from 1.",
            "format": "int64",
            "type": "integer"
          },
          "aggregate_type": {
            "description": "What changed: the aggregate's kind, for example `tenant`.",
            "type": "string"
          },
          "event_id": {
            "$ref": "#/components/schemas/EventId",
            "description": "The event's ID (UUIDv7)."
          },
          "occurred_at": {
            "description": "When the change happened, by the producer's clock.",
            "format": "date-time",
            "type": "string"
          },
          "payload": {
            "description": "The event's payload as the producer wrote it, in the version above; a JSON object.",
            "type": "object"
          },
          "producer": {
            "description": "The service that wrote the event, for example `identity`.",
            "type": "string"
          },
          "recorded_at": {
            "description": "When the event log stored the event, by the database clock.",
            "format": "date-time",
            "type": "string"
          },
          "tenant_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/TenantId",
                "description": "The tenant; `null` for a platform-wide event."
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "description": "The event type, for example `identity.tenant_created`.",
            "type": "string"
          },
          "version": {
            "description": "The payload's version.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "event_id",
          "type",
          "version",
          "producer",
          "occurred_at",
          "recorded_at",
          "aggregate_type",
          "aggregate_id",
          "aggregate_seq",
          "payload"
        ],
        "type": "object"
      },
      "MessageKey": {
        "description": "Key of the translated message the client shows; never the message itself.",
        "examples": [
          "error.not_found"
        ],
        "maxLength": 128,
        "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$",
        "type": "string"
      },
      "Tenant": {
        "description": "A tenant.",
        "properties": {
          "created_at": {
            "description": "When the tenant was created, by the database clock.",
            "format": "date-time",
            "type": "string"
          },
          "name": {
            "description": "The name, trimmed.",
            "type": "string"
          },
          "tenant_id": {
            "$ref": "#/components/schemas/TenantId",
            "description": "The tenant's ID (UUIDv7)."
          }
        },
        "required": [
          "tenant_id",
          "name",
          "created_at"
        ],
        "type": "object"
      },
      "TenantId": {
        "description": "A tenant: one customer organisation; every tenant-scoped row and event carries it.\n\nSerialized as a lowercase hyphenated UUID string.",
        "format": "uuid",
        "type": "string"
      },
      "UserId": {
        "description": "A user account; one user can be a member of several tenants.\n\nSerialized as a lowercase hyphenated UUID string.",
        "format": "uuid",
        "type": "string"
      }
    }
  },
  "info": {
    "title": "TrustIoT API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/assets/v1/tenant": {
      "get": {
        "operationId": "getAssetsTenant",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetsTenant"
                }
              }
            },
            "description": "The caller's tenant."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No valid session (`unauthenticated`)."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The user has not picked or joined a tenant (`permission_denied`)."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The service has not processed the tenant's creation yet (`not_found`)."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The database failed (`unavailable`)."
          }
        },
        "summary": "The caller's tenant, once this service has processed its `identity.tenant_created`.",
        "tags": [
          "assets"
        ]
      }
    },
    "/api/identity/v1/event-log": {
      "get": {
        "operationId": "getTenantEventLog",
        "parameters": [
          {
            "description": "Only events that occurred at or after this RFC 3339 time.",
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Only events that occurred before this RFC 3339 time; after `from`.",
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Events per page, 1 to 500; default 100.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "maximum": 500,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "The previous page's `next_cursor`, for the next, older page.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventLogPage"
                }
              }
            },
            "description": "A page of the tenant's events, newest first."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "A malformed parameter, or `from` not before `to` (`invalid_request`)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No valid session (`unauthenticated`)."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The user has no tenant, or is not an administrator of it (`permission_denied`)."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The database failed, or the event log is off (`unavailable`)."
          }
        },
        "summary": "The caller's tenant's operation log. Administrators of the tenant only.",
        "tags": [
          "identity"
        ]
      }
    },
    "/api/identity/v1/platform/event-log": {
      "get": {
        "operationId": "getPlatformEventLog",
        "parameters": [
          {
            "description": "Only events that occurred at or after this RFC 3339 time.",
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Only events that occurred before this RFC 3339 time; after `from`.",
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Events per page, 1 to 500; default 100.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "maximum": 500,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "The previous page's `next_cursor`, for the next, older page.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventLogPage"
                }
              }
            },
            "description": "A page of the platform-wide events, newest first."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "A malformed parameter, or `from` not before `to` (`invalid_request`)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No valid session (`unauthenticated`)."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The user is not a platform administrator (`permission_denied`)."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The database failed, or the event log is off (`unavailable`)."
          }
        },
        "summary": "The platform-wide operation log, for the back office. Platform administrators only.",
        "tags": [
          "identity"
        ]
      }
    },
    "/api/identity/v1/platform/tenants/{tenant_id}/event-log": {
      "get": {
        "operationId": "getPlatformTenantEventLog",
        "parameters": [
          {
            "description": "The tenant's ID. An ID no tenant has gives an empty page.",
            "in": "path",
            "name": "tenant_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Only events that occurred at or after this RFC 3339 time.",
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Only events that occurred before this RFC 3339 time; after `from`.",
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Events per page, 1 to 500; default 100.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "maximum": 500,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "The previous page's `next_cursor`, for the next, older page.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventLogPage"
                }
              }
            },
            "description": "A page of the tenant's events, newest first."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "A malformed tenant ID or parameter, or `from` not before `to` (`invalid_request`)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No valid session (`unauthenticated`)."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The user is not a platform administrator (`permission_denied`)."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The database failed, or the event log is off (`unavailable`)."
          }
        },
        "summary": "One tenant's operation log, for the back office. Platform administrators only.",
        "tags": [
          "identity"
        ]
      }
    },
    "/api/identity/v1/tenants": {
      "post": {
        "operationId": "createTenant",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTenant"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tenant"
                }
              }
            },
            "description": "The tenant was created, and `identity.tenant_created` written in the same transaction."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The `Content-Type` is not `application/json`, or the body is not a JSON object with a string `name` (`invalid_request`)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No valid session (`unauthenticated`)."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The user is not a platform administrator (`permission_denied`)."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The name is empty, longer than 100 characters, or holds a control or format character or a line or paragraph separator (`validation_failed`, field `/name`, `tenant.name_invalid`)."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The database failed; nothing was created (`unavailable`)."
          }
        },
        "summary": "Creates a tenant. Platform administrators only.",
        "tags": [
          "identity"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Sites, devices and data points (services/assets).",
      "name": "assets"
    },
    {
      "description": "Sessions, users and tenants (services/identity).",
      "name": "identity"
    }
  ]
}
