{
  "components": {
    "schemas": {
      "AssetsTenant": {
        "description": "The caller's tenant as this service knows it.",
        "properties": {
          "created_at": {
            "description": "When this service learned of the tenant, by the database clock.",
            "format": "date-time",
            "type": "string"
          },
          "tenant_id": {
            "$ref": "#/components/schemas/TenantId",
            "description": "The tenant's ID."
          }
        },
        "required": [
          "tenant_id",
          "created_at"
        ],
        "type": "object"
      },
      "CreateTenant": {
        "description": "The body of `POST /api/identity/v1/tenants`. Unknown fields are ignored.",
        "properties": {
          "name": {
            "description": "What people call the tenant: 1 to 100 characters after trimming, without control or\nformat characters or line and paragraph separators.",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "ErrorBody": {
        "description": "The JSON body of every error response (M1). Clients ignore fields they do not know, so\nfields are only ever added as optional ones.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode",
            "description": "What went wrong; clients branch on this."
          },
          "details": {
            "description": "Values the translated message refers to, for example `{\"max\": 40}`. Never user-facing\ntext, internal error text, or personal data. Absent when empty.",
            "type": "object"
          },
          "field_errors": {
            "description": "The request fields that were rejected. Absent when empty.",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
          "message_key": {
            "$ref": "#/components/schemas/MessageKey",
            "description": "The message the client shows, translated by the client."
          }
        },
        "required": [
          "code",
          "message_key"
        ],
        "type": "object"
      },
      "ErrorCode": {
        "description": "What went wrong, as one of a closed set of codes (M1). The HTTP status follows from the\ncode; a more specific reason goes in the message key, not in a new code.",
        "enum": [
          "invalid_request",
          "validation_failed",
          "unauthenticated",
          "permission_denied",
          "tenant_suspended",
          "quota_exceeded",
          "not_found",
          "conflict",
          "rate_limited",
          "internal",
          "unavailable",
          "timeout"
        ],
        "type": "string"
      },
      "FieldError": {
        "description": "A rejected field of the request body.",
        "properties": {
          "details": {
            "description": "Values the message refers to. Absent when empty.",
            "type": "object"
          },
          "field": {
            "description": "JSON Pointer (RFC 6901) to the rejected value in the request body, for example\n`/points/3/address`; an empty string means the whole body.",
            "type": "string"
          },
          "message_key": {
            "$ref": "#/components/schemas/MessageKey",
            "description": "The message the client shows next to the field."
          }
        },
        "required": [
          "field",
          "message_key"
        ],
        "type": "object"
      },
      "Interval": {
        "description": "How readings are grouped: `raw` (no grouping) or a bucket length.",
        "enum": [
          "raw",
          "1m",
          "5m",
          "15m",
          "1h",
          "3h",
          "6h",
          "12h",
          "1d"
        ],
        "type": "string"
      },
      "Latest": {
        "description": "The latest value of each data point of a device that has a reading in the raw period.",
        "properties": {
          "device_id": {
            "description": "The device.",
            "format": "uuid",
            "type": "string"
          },
          "earliest": {
            "description": "The start of the period searched (the raw period), UTC.",
            "format": "date-time",
            "type": "string"
          },
          "points": {
            "description": "One entry per data point, ordered by data point.",
            "items": {
              "$ref": "#/components/schemas/LatestPoint"
            },
            "type": "array"
          }
        },
        "required": [
          "device_id",
          "earliest",
          "points"
        ],
        "type": "object"
      },
      "LatestPoint": {
        "description": "The latest value of one data point.",
        "properties": {
          "point": {
            "description": "The data point.",
            "type": "string"
          },
          "time": {
            "description": "When the reading was taken, UTC.",
            "format": "date-time",
            "type": "string"
          },
          "value": {
            "$ref": "#/components/schemas/Reading",
            "description": "The reading."
          }
        },
        "required": [
          "point",
          "time",
          "value"
        ],
        "type": "object"
      },
      "MessageKey": {
        "description": "Key of the translated message the client shows; never the message itself.",
        "examples": [
          "error.not_found"
        ],
        "maxLength": 128,
        "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$",
        "type": "string"
      },
      "Reading": {
        "description": "One reading's value, as its type stored it.",
        "oneOf": [
          {
            "description": "A floating-point reading; `null` for NaN or an infinity.",
            "properties": {
              "type": {
                "enum": [
                  "float"
                ],
                "type": "string"
              },
              "value": {
                "description": "A floating-point reading; `null` for NaN or an infinity.",
                "format": "double",
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "value",
              "type"
            ],
            "type": "object"
          },
          {
            "description": "An integer reading.",
            "properties": {
              "type": {
                "enum": [
                  "int"
                ],
                "type": "string"
              },
              "value": {
                "description": "An integer reading.",
                "format": "int64",
                "type": "integer"
              }
            },
            "required": [
              "value",
              "type"
            ],
            "type": "object"
          },
          {
            "description": "A boolean reading.",
            "properties": {
              "type": {
                "enum": [
                  "bool"
                ],
                "type": "string"
              },
              "value": {
                "description": "A boolean reading.",
                "type": "boolean"
              }
            },
            "required": [
              "value",
              "type"
            ],
            "type": "object"
          },
          {
            "description": "A text reading.",
            "properties": {
              "type": {
                "enum": [
                  "string"
                ],
                "type": "string"
              },
              "value": {
                "description": "A text reading.",
                "type": "string"
              }
            },
            "required": [
              "value",
              "type"
            ],
            "type": "object"
          }
        ]
      },
      "Series": {
        "description": "A data point's series.",
        "properties": {
          "device_id": {
            "description": "The device.",
            "format": "uuid",
            "type": "string"
          },
          "earliest": {
            "description": "The start of the queryable period for this interval at the time of the request.",
            "format": "date-time",
            "type": "string"
          },
          "from": {
            "description": "The range queried, `from` inclusive and `to` exclusive, UTC; `from` is later than\nrequested when the request started before the queryable period.",
            "format": "date-time",
            "type": "string"
          },
          "interval": {
            "$ref": "#/components/schemas/Interval",
            "description": "The interval used: the requested one, or the automatic choice."
          },
          "point": {
            "description": "The data point.",
            "type": "string"
          },
          "points": {
            "description": "The buckets with readings, in time order; buckets without readings are left out.",
            "items": {
              "$ref": "#/components/schemas/SeriesPoint"
            },
            "type": "array"
          },
          "to": {
            "format": "date-time",
            "type": "string"
          },
          "truncated": {
            "description": "Whether `from` was moved to the start of the queryable period.",
            "type": "boolean"
          },
          "tz": {
            "description": "The time zone the buckets follow.",
            "type": "string"
          }
        },
        "required": [
          "device_id",
          "point",
          "tz",
          "interval",
          "from",
          "to",
          "truncated",
          "earliest",
          "points"
        ],
        "type": "object"
      },
      "SeriesPoint": {
        "description": "One bucket of a series (for `raw`, one reading).",
        "properties": {
          "avg": {
            "description": "The mean of the numeric values.",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "count": {
            "description": "How many readings the bucket holds.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "last": {
            "$ref": "#/components/schemas/Reading",
            "description": "The bucket's latest reading."
          },
          "max": {
            "description": "The largest numeric value.",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "min": {
            "description": "The smallest numeric value (a bool counts as 0 or 1); `null` when the bucket holds only\ntext readings.",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "time": {
            "description": "The bucket's start (for `raw`, the reading's time), UTC.",
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "time",
          "count",
          "last"
        ],
        "type": "object"
      },
      "Tenant": {
        "description": "A tenant.",
        "properties": {
          "created_at": {
            "description": "When the tenant was created, by the database clock.",
            "format": "date-time",
            "type": "string"
          },
          "name": {
            "description": "The name, trimmed.",
            "type": "string"
          },
          "tenant_id": {
            "$ref": "#/components/schemas/TenantId",
            "description": "The tenant's ID (UUIDv7)."
          }
        },
        "required": [
          "tenant_id",
          "name",
          "created_at"
        ],
        "type": "object"
      },
      "TenantId": {
        "description": "A tenant: one customer organisation; every tenant-scoped row and event carries it.\n\nSerialized as a lowercase hyphenated UUID string.",
        "format": "uuid",
        "type": "string"
      }
    }
  },
  "info": {
    "title": "TrustIoT API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/assets/v1/tenant": {
      "get": {
        "operationId": "getAssetsTenant",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetsTenant"
                }
              }
            },
            "description": "The caller's tenant."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No valid session (`unauthenticated`)."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The user has not picked or joined a tenant (`permission_denied`)."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The service has not processed the tenant's creation yet (`not_found`)."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The database failed (`unavailable`)."
          }
        },
        "summary": "The caller's tenant, once this service has processed its `identity.tenant_created`.",
        "tags": [
          "assets"
        ]
      }
    },
    "/api/identity/v1/tenants": {
      "post": {
        "operationId": "createTenant",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTenant"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tenant"
                }
              }
            },
            "description": "The tenant was created, and `identity.tenant_created` written in the same transaction."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The `Content-Type` is not `application/json`, or the body is not a JSON object with a string `name` (`invalid_request`)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No valid session (`unauthenticated`)."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The user is not a platform administrator (`permission_denied`)."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The name is empty, longer than 100 characters, or holds a control or format character or a line or paragraph separator (`validation_failed`, field `/name`, `tenant.name_invalid`)."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The database failed; nothing was created (`unavailable`)."
          }
        },
        "summary": "Creates a tenant. Platform administrators only.",
        "tags": [
          "identity"
        ]
      }
    },
    "/api/telemetry/v1/devices/{device_id}/latest": {
      "get": {
        "operationId": "getTelemetryLatest",
        "parameters": [
          {
            "description": "The device.",
            "in": "path",
            "name": "device_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Latest"
                }
              }
            },
            "description": "The latest values; empty when the device has no reading in the raw period, or is not the tenant's."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "A malformed device ID (`invalid_request`)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No valid session (`unauthenticated`)."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The user has not picked or joined a tenant (`permission_denied`)."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The tenant's account has not been created yet (`not_found`, `telemetry.account_not_ready`)."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The device has more data points than one answer holds (`telemetry.too_many_points`), or the query reads or holds too much (`telemetry.query_too_heavy`)."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The tenant's query quota or concurrency limit is used up (`rate_limited`)."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Postgres or ClickHouse failed, or the tenant's ClickHouse account is not as the service creates it (`unavailable`)."
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The query ran into its time limit (`timeout`)."
          }
        },
        "summary": "The latest value of each data point of a device, from the readings of the raw period.",
        "tags": [
          "telemetry"
        ]
      }
    },
    "/api/telemetry/v1/devices/{device_id}/series": {
      "get": {
        "operationId": "getTelemetrySeries",
        "parameters": [
          {
            "description": "The device.",
            "in": "path",
            "name": "device_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "The data point key (1 to 128 characters).",
            "in": "query",
            "name": "point",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The range's start, RFC 3339 (inclusive). Percent-encode a `+` offset, or use `Z`.",
            "in": "query",
            "name": "from",
            "required": true,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "The range's end, RFC 3339 (exclusive).",
            "in": "query",
            "name": "to",
            "required": true,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "An IANA time zone name, for example `Asia/Taipei`: hour and day buckets start at its local hours and midnights.",
            "in": "query",
            "name": "tz",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "`raw`, `1m`, `5m`, `15m`, `1h`, `3h`, `6h`, `12h` or `1d`; without it, the finest interval that gives at most 1500 buckets.",
            "in": "query",
            "name": "interval",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Interval"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Series"
                }
              }
            },
            "description": "The series."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "A malformed device ID or query string (`invalid_request`)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No valid session (`unauthenticated`)."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No tenant (`permission_denied`), or the range lies wholly before the queryable period (`quota_exceeded`, `telemetry.outside_queryable_period`, detail `earliest`)."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The tenant's account has not been created yet (`not_found`, `telemetry.account_not_ready`)."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "A parameter breaks a rule (`validation_failed`, detail `parameter`), the series would have too many points (`telemetry.too_many_points`), or the query reads or holds too much (`telemetry.query_too_heavy`)."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The tenant's query quota or concurrency limit is used up (`rate_limited`)."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Postgres or ClickHouse failed, or the tenant's ClickHouse account is not as the service creates it (`unavailable`)."
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The query ran into its time limit (`timeout`)."
          }
        },
        "summary": "A data point's series over a time range: raw readings, or buckets of an interval that\nfollow the time zone `tz`, within the queryable period.",
        "tags": [
          "telemetry"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Sites, devices and data points (services/assets).",
      "name": "assets"
    },
    {
      "description": "Sessions, users and tenants (services/identity).",
      "name": "identity"
    },
    {
      "description": "Device telemetry history (services/telemetry-query).",
      "name": "telemetry"
    }
  ]
}
