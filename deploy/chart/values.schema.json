{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TrustIoT chart values",
  "description": "Validated by helm lint, template and install. README.md documents every field.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "global",
    "hosts",
    "ingress",
    "serviceDefaults",
    "services",
    "mesh",
    "postgres",
    "clickhouse",
    "qdrant",
    "objectStorage",
    "smtp",
    "ai",
    "observability"
  ],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deploymentMode", "imagePullSecrets"],
      "properties": {
        "deploymentMode": {
          "description": "Deployment shape, set by values-saas.yaml or values-onprem.yaml.",
          "enum": ["saas", "onprem"]
        },
        "imagePullSecrets": {
          "type": "array",
          "items": { "$ref": "#/definitions/k8sName" }
        }
      }
    },
    "hosts": {
      "description": "Our own domain names, never IP addresses (portability rule 1).",
      "type": "object",
      "additionalProperties": false,
      "required": ["app", "gateway", "ota"],
      "properties": {
        "app": { "$ref": "#/definitions/dnsName" },
        "gateway": { "$ref": "#/definitions/dnsName" },
        "ota": { "$ref": "#/definitions/dnsName" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exposure",
        "authzProvider",
        "replicas",
        "resources",
        "tunnel",
        "direct",
        "publicPaths",
        "routes"
      ],
      "properties": {
        "exposure": { "enum": ["tunnel", "direct"] },
        "authzProvider": {
          "description": "Name of the istiod meshConfig extension provider that calls the identity service.",
          "type": "string",
          "maxLength": 253,
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "replicas": { "type": "integer", "minimum": 1, "maximum": 10 },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requests", "limits"],
          "properties": {
            "requests": { "$ref": "#/definitions/resourceList" },
            "limits": { "allOf": [{ "$ref": "#/definitions/resourceList" }, { "required": ["memory"] }] }
          }
        },
        "tunnel": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowedSources"],
          "properties": {
            "allowedSources": {
              "description": "IPv4 CIDRs allowed to reach the ingress pods in tunnel mode; never the whole network.",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/definitions/hostCidr" }
            }
          }
        },
        "direct": {
          "type": "object",
          "additionalProperties": false,
          "required": ["serviceType", "tlsSecret"],
          "properties": {
            "serviceType": { "enum": ["LoadBalancer", "NodePort", "ClusterIP"] },
            "tlsSecret": { "$ref": "#/definitions/optionalK8sName" }
          }
        },
        "publicPaths": {
          "description": "The only cookie-free paths (decision 27): exact paths, no wildcards.",
          "type": "object",
          "additionalProperties": false,
          "required": ["login", "healthCheck", "certRenewal", "mqtt"],
          "properties": {
            "login": { "$ref": "#/definitions/exactPath" },
            "healthCheck": { "$ref": "#/definitions/exactPath" },
            "certRenewal": { "$ref": "#/definitions/exactPath" },
            "mqtt": { "$ref": "#/definitions/exactPath" }
          }
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["host", "path", "match", "service"],
            "properties": {
              "host": { "enum": ["app", "gateway", "ota"] },
              "path": { "$ref": "#/definitions/routePath" },
              "match": { "enum": ["PathPrefix", "Exact"] },
              "service": { "type": "string", "pattern": "^[a-z]([a-z0-9-]{0,30}[a-z0-9])?$" },
              "port": { "type": "string", "pattern": "^[a-z]([a-z0-9-]{0,13}[a-z0-9])?$" }
            }
          }
        }
      },
      "if": { "properties": { "exposure": { "const": "direct" } } },
      "then": { "properties": { "direct": { "properties": { "tlsSecret": { "minLength": 1 } } } } }
    },
    "serviceDefaults": {
      "allOf": [
        { "$ref": "#/definitions/serviceSpec" },
        {
          "required": [
            "image",
            "replicas",
            "ports",
            "env",
            "resources",
            "podSecurityContext",
            "securityContext",
            "probes",
            "preStopSleepSeconds",
            "drainSeconds",
            "tmpSizeLimit",
            "automountServiceAccountToken",
            "nodeSelector",
            "tolerations",
            "affinity",
            "podLabels",
            "podAnnotations"
          ],
          "properties": {
            "enabled": false,
            "credentials": false,
            "env": {
              "description": "Every service gets serviceDefaults.env, so it must not read Secrets.",
              "items": { "properties": { "valueFrom": { "not": { "required": ["secretKeyRef"] } } } }
            },
            "image": { "required": ["registry", "repository", "tag", "digest", "pullPolicy"] },
            "resources": {
              "required": ["requests", "limits"],
              "properties": { "limits": { "required": ["memory"] } }
            },
            "podSecurityContext": { "required": ["runAsNonRoot", "seccompProfile"] },
            "securityContext": {
              "required": ["allowPrivilegeEscalation", "readOnlyRootFilesystem", "capabilities"],
              "properties": { "capabilities": { "required": ["drop"] } }
            },
            "probes": { "required": ["liveness", "readiness"] }
          }
        }
      ]
    },
    "services": {
      "description": "TrustIoT services keyed by name; each entry overrides serviceDefaults.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z]([a-z0-9-]{0,30}[a-z0-9])?$" },
      "additionalProperties": {
        "allOf": [{ "$ref": "#/definitions/serviceSpec" }, { "required": ["enabled"] }]
      }
    },
    "mesh": {
      "description": "Service-to-service authorization (decision 27).",
      "type": "object",
      "additionalProperties": false,
      "required": ["trustDomain", "calls"],
      "properties": {
        "trustDomain": { "$ref": "#/definitions/dnsName" },
        "calls": {
          "description": "Who may call whom: <caller>: [<callee>, ...], both keys under services.",
          "type": "object",
          "propertyNames": { "pattern": "^[a-z]([a-z0-9-]{0,30}[a-z0-9])?$" },
          "additionalProperties": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z]([a-z0-9-]{0,30}[a-z0-9])?$" }
          }
        }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "external"],
      "properties": {
        "mode": { "enum": ["bundled", "external"] },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "port", "database", "sslMode", "caSecret"],
          "properties": {
            "host": { "$ref": "#/definitions/optionalHostOrIp" },
            "port": { "$ref": "#/definitions/port" },
            "database": { "type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$" },
            "sslMode": { "const": "verify-full" },
            "caSecret": { "$ref": "#/definitions/secretKeyRef" }
          }
        }
      },
      "if": { "properties": { "mode": { "const": "external" } } },
      "then": {
        "properties": {
          "external": {
            "properties": {
              "host": { "minLength": 1 },
              "caSecret": { "properties": { "name": { "minLength": 1 } } }
            }
          }
        }
      }
    },
    "clickhouse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "bundled", "external"],
      "properties": {
        "mode": { "enum": ["bundled", "external"] },
        "bundled": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "image",
            "adminUser",
            "adminSecret",
            "adminSecretRevision",
            "storage",
            "resources",
            "podSecurityContext",
            "nodeSelector",
            "tolerations"
          ],
          "properties": {
            "image": {
              "description": "Pinned by digest (decision 14: fixed version).",
              "type": "object",
              "additionalProperties": false,
              "required": ["repository", "tag", "digest", "pullPolicy"],
              "properties": {
                "repository": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([a-z0-9.:-]*[a-z0-9])?(/[a-z0-9]([a-z0-9._-]*[a-z0-9])?)*$"
                },
                "tag": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$" },
                "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
                "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
              }
            },
            "adminUser": {
              "description": "Bootstrap account with access management, used only by the migration Job.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "not": { "const": "default" }
            },
            "adminSecret": { "$ref": "#/definitions/secretKeyRef" },
            "adminSecretRevision": {
              "description": "Change after rotating the admin Secret; restarts ClickHouse so it reads the new password.",
              "oneOf": [
                { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,63}$" },
                { "type": "integer", "minimum": 0 }
              ]
            },
            "storage": {
              "type": "object",
              "additionalProperties": false,
              "required": ["size", "storageClassName"],
              "properties": {
                "size": { "anyOf": [{ "const": "" }, { "$ref": "#/definitions/quantity" }] },
                "storageClassName": { "$ref": "#/definitions/optionalK8sName" }
              }
            },
            "resources": {
              "type": "object",
              "additionalProperties": false,
              "required": ["requests", "limits"],
              "properties": {
                "requests": { "$ref": "#/definitions/resourceList" },
                "limits": { "allOf": [{ "$ref": "#/definitions/resourceList" }, { "required": ["memory"] }] }
              }
            },
            "podSecurityContext": {
              "allOf": [
                { "$ref": "#/definitions/podSecurityContext" },
                { "required": ["runAsNonRoot", "seccompProfile"] }
              ]
            },
            "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
            "tolerations": { "type": "array", "items": { "type": "object" } }
          }
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "caSecret"],
          "properties": {
            "url": { "$ref": "#/definitions/optionalHttpsUrl" },
            "caSecret": { "$ref": "#/definitions/secretKeyRef" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "external" } } },
          "then": { "properties": { "external": { "properties": { "url": { "minLength": 1 } } } } }
        },
        {
          "if": { "properties": { "mode": { "const": "bundled" } } },
          "then": {
            "properties": {
              "bundled": {
                "properties": {
                  "adminSecret": { "properties": { "name": { "minLength": 1 } } },
                  "storage": { "properties": { "size": { "minLength": 1 } } }
                }
              }
            }
          }
        }
      ]
    },
    "qdrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "external"],
      "properties": {
        "mode": { "enum": ["bundled", "external"] },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "credentialsSecret"],
          "properties": {
            "url": { "$ref": "#/definitions/optionalHttpsUrl" },
            "credentialsSecret": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "readApiKeyKey", "writeApiKeyKey"],
              "properties": {
                "name": { "$ref": "#/definitions/optionalK8sName" },
                "readApiKeyKey": { "$ref": "#/definitions/secretKey" },
                "writeApiKeyKey": { "$ref": "#/definitions/secretKey" }
              }
            }
          }
        }
      },
      "if": { "properties": { "mode": { "const": "external" } } },
      "then": { "properties": { "external": { "properties": { "url": { "minLength": 1 } } } } }
    },
    "objectStorage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "region", "bucket", "forcePathStyle", "credentialsSecret"],
      "properties": {
        "endpoint": { "$ref": "#/definitions/optionalHttpUrl" },
        "region": { "type": "string", "pattern": "^[a-z0-9-]{0,32}$" },
        "bucket": { "type": "string", "pattern": "^$|^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$" },
        "forcePathStyle": { "type": "boolean" },
        "credentialsSecret": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "accessKeyIdKey", "secretAccessKeyKey"],
          "properties": {
            "name": { "$ref": "#/definitions/optionalK8sName" },
            "accessKeyIdKey": { "$ref": "#/definitions/secretKey" },
            "secretAccessKeyKey": { "$ref": "#/definitions/secretKey" }
          }
        }
      }
    },
    "smtp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "security", "from", "credentialsSecret"],
      "properties": {
        "host": { "$ref": "#/definitions/optionalHostOrIp" },
        "port": { "$ref": "#/definitions/port" },
        "security": { "enum": ["starttls", "tls"] },
        "from": {
          "description": "Single line only, so it cannot inject mail headers.",
          "type": "string",
          "maxLength": 320,
          "pattern": "^[^\\r\\n]*$"
        },
        "credentialsSecret": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "usernameKey", "passwordKey"],
          "properties": {
            "name": { "$ref": "#/definitions/optionalK8sName" },
            "usernameKey": { "$ref": "#/definitions/secretKey" },
            "passwordKey": { "$ref": "#/definitions/secretKey" }
          }
        }
      }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chat", "embedding", "rerank"],
      "properties": {
        "chat": { "$ref": "#/definitions/aiEndpoint" },
        "embedding": { "$ref": "#/definitions/aiEndpoint" },
        "rerank": { "$ref": "#/definitions/aiEndpoint" }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sentry", "collector"],
      "properties": {
        "sentry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "environment", "dsnSecret"],
          "properties": {
            "enabled": { "type": "boolean" },
            "environment": { "type": "string", "pattern": "^$|^[A-Za-z0-9_.-]{1,64}$" },
            "dsnSecret": { "$ref": "#/definitions/secretKeyRef" }
          },
          "if": { "properties": { "enabled": { "const": true } } },
          "then": {
            "properties": {
              "environment": { "minLength": 1 },
              "dsnSecret": { "properties": { "name": { "minLength": 1 } } }
            }
          }
        },
        "collector": {
          "description": "OpenTelemetry collector (decision 22): redacts and writes logs and traces to ClickHouse, optionally forwards them to a SIEM.",
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "image", "clickhouse", "forward", "resources", "podSecurityContext", "nodeSelector", "tolerations"],
          "properties": {
            "enabled": { "type": "boolean" },
            "image": {
              "description": "Pinned by digest.",
              "type": "object",
              "additionalProperties": false,
              "required": ["repository", "tag", "digest", "pullPolicy"],
              "properties": {
                "repository": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9.:-]*[a-z0-9])?(/[a-z0-9]([a-z0-9._-]*[a-z0-9])?)*$" },
                "tag": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$" },
                "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
                "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
              }
            },
            "clickhouse": {
              "type": "object",
              "additionalProperties": false,
              "required": ["user", "passwordSecret"],
              "properties": {
                "user": {
                  "description": "Account created by the migration Job with the trustiot_otel_collector role.",
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,62}$",
                  "not": { "enum": ["default", "trustiot_otel_collector"] }
                },
                "passwordSecret": { "$ref": "#/definitions/secretKeyRef" }
              }
            },
            "forward": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "endpoint", "protocol", "signals", "authHeader", "caSecret"],
              "properties": {
                "enabled": { "type": "boolean" },
                "endpoint": { "$ref": "#/definitions/optionalHttpUrl" },
                "protocol": { "enum": ["http", "grpc"] },
                "signals": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "enum": ["logs", "traces"] }
                },
                "authHeader": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "secret"],
                  "properties": {
                    "name": {
                      "description": "HTTP header name; its whole value comes from the Secret.",
                      "type": "string",
                      "pattern": "^$|^[A-Za-z][A-Za-z0-9-]{0,63}$"
                    },
                    "secret": { "$ref": "#/definitions/secretKeyRef" }
                  },
                  "if": { "properties": { "name": { "minLength": 1 } } },
                  "then": { "properties": { "secret": { "properties": { "name": { "minLength": 1 } } } } }
                },
                "caSecret": { "$ref": "#/definitions/secretKeyRef" }
              },
              "if": { "properties": { "enabled": { "const": true } } },
              "then": { "properties": { "endpoint": { "minLength": 1 } } }
            },
            "resources": {
              "type": "object",
              "additionalProperties": false,
              "required": ["requests", "limits"],
              "properties": {
                "requests": { "$ref": "#/definitions/resourceList" },
                "limits": { "allOf": [{ "$ref": "#/definitions/resourceList" }, { "required": ["memory"] }] }
              }
            },
            "podSecurityContext": {
              "allOf": [{ "$ref": "#/definitions/podSecurityContext" }, { "required": ["runAsNonRoot", "seccompProfile"] }]
            },
            "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
            "tolerations": { "type": "array", "items": { "type": "object" } }
          },
          "if": { "properties": { "enabled": { "const": true } } },
          "then": { "properties": { "clickhouse": { "properties": { "passwordSecret": { "properties": { "name": { "minLength": 1 } } } } } } }
        }
      }
    }
  },
  "allOf": [
    {
      "description": "On-prem never goes through Cloudflare: the ingress gateway faces the customer network (decision 27).",
      "if": {
        "required": ["global"],
        "properties": { "global": { "required": ["deploymentMode"], "properties": { "deploymentMode": { "const": "onprem" } } } }
      },
      "then": { "properties": { "ingress": { "properties": { "exposure": { "const": "direct" } } } } }
    },
    {
      "description": "SaaS reaches every external endpoint over the internet, so they must use https.",
      "if": {
        "required": ["global"],
        "properties": { "global": { "required": ["deploymentMode"], "properties": { "deploymentMode": { "const": "saas" } } } }
      },
      "then": {
        "properties": {
          "objectStorage": { "properties": { "endpoint": { "$ref": "#/definitions/optionalHttpsUrl" } } },
          "ai": {
            "properties": {
              "chat": { "properties": { "baseUrl": { "$ref": "#/definitions/optionalHttpsUrl" } } },
              "embedding": { "properties": { "baseUrl": { "$ref": "#/definitions/optionalHttpsUrl" } } },
              "rerank": { "properties": { "baseUrl": { "$ref": "#/definitions/optionalHttpsUrl" } } }
            }
          },
          "observability": {
            "properties": {
              "collector": {
                "properties": { "forward": { "properties": { "endpoint": { "$ref": "#/definitions/optionalHttpsUrl" } } } }
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "dnsName": {
      "description": "Lower-case DNS name with at least two labels; the last label starts with a letter, so IP addresses are rejected.",
      "type": "string",
      "maxLength": 253,
      "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]([a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "optionalHostOrIp": {
      "description": "Empty, a lower-case DNS name or an IPv4 address.",
      "type": "string",
      "maxLength": 253,
      "pattern": "^$|^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$"
    },
    "optionalHttpUrl": {
      "description": "Empty or an http(s) URL without user info, so credentials never sit in values.",
      "type": "string",
      "maxLength": 2048,
      "pattern": "^$|^https?://[^\\s/?#@]+(/[^\\s]*)?$"
    },
    "optionalHttpsUrl": {
      "description": "Empty or an https URL without user info.",
      "type": "string",
      "maxLength": 2048,
      "pattern": "^$|^https://[^\\s/?#@]+(/[^\\s]*)?$"
    },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "hostCidr": {
      "description": "IPv4 CIDR with a prefix of at least /8.",
      "type": "string",
      "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])/(3[0-2]|[12][0-9]|[89])$"
    },
    "exactPath": {
      "description": "One exact lower-case path: segments start with a letter or digit, so no '.', '..', '//', trailing '/', '%', ';' or wildcards; never under /internal (decision 27).",
      "type": "string",
      "maxLength": 256,
      "pattern": "^(/[a-z0-9][a-z0-9._-]*)+$",
      "not": { "pattern": "^/internal" }
    },
    "routePath": {
      "description": "'/' or a lower-case path in the exactPath form; never under /internal (decision 27).",
      "type": "string",
      "maxLength": 256,
      "pattern": "^/$|^(/[a-z0-9][a-z0-9._-]*)+$",
      "not": { "pattern": "^/internal" }
    },
    "k8sName": {
      "description": "DNS-1123 subdomain, the format of Kubernetes object names.",
      "type": "string",
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
    },
    "optionalK8sName": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
    },
    "secretKey": { "type": "string", "maxLength": 253, "pattern": "^[-._a-zA-Z0-9]+$" },
    "secretKeyRef": {
      "description": "Reference to one key of an existing Secret; an empty name means not configured.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "key"],
      "properties": {
        "name": { "$ref": "#/definitions/optionalK8sName" },
        "key": { "$ref": "#/definitions/secretKey" }
      }
    },
    "aiEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseUrl", "apiKeySecret"],
      "properties": {
        "baseUrl": { "$ref": "#/definitions/optionalHttpUrl" },
        "apiKeySecret": { "$ref": "#/definitions/secretKeyRef" }
      }
    },
    "quantity": {
      "type": ["string", "number"],
      "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|T|P|E|Ki|Mi|Gi|Ti|Pi|Ei)?$"
    },
    "resourceList": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": { "$ref": "#/definitions/quantity" },
        "memory": { "$ref": "#/definitions/quantity" },
        "ephemeral-storage": { "$ref": "#/definitions/quantity" }
      }
    },
    "probe": {
      "description": "A Kubernetes probe object; {} disables an optional probe.",
      "type": "object"
    },
    "containerPort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "containerPort"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z]([a-z0-9-]{0,13}[a-z0-9])?$" },
        "containerPort": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "servicePort": { "$ref": "#/definitions/port" },
        "protocol": { "enum": ["TCP", "UDP", "SCTP"] },
        "appProtocol": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9./-]*[a-z0-9])?$" }
      }
    },
    "envKeyRef": {
      "description": "Kubernetes SecretKeySelector or ConfigMapKeySelector.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "key"],
      "properties": {
        "name": { "$ref": "#/definitions/k8sName" },
        "key": { "$ref": "#/definitions/secretKey" },
        "optional": { "type": "boolean" }
      }
    },
    "envVar": {
      "description": "Kubernetes EnvVar with either a literal value or exactly one valueFrom source.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "not": {
            "description": "Names starting with TRUSTIOT_ plus a letter or digit, SENTRY_ or OTEL_ are set by the chart.",
            "pattern": "(?i)^(TRUSTIOT_[A-Z0-9]|SENTRY_|OTEL_)"
          }
        },
        "value": { "type": "string" },
        "valueFrom": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "secretKeyRef": { "$ref": "#/definitions/envKeyRef" },
            "configMapKeyRef": { "$ref": "#/definitions/envKeyRef" },
            "fieldRef": { "type": "object" },
            "resourceFieldRef": { "type": "object" }
          }
        }
      },
      "not": { "required": ["value", "valueFrom"] },
      "if": {
        "properties": {
          "name": { "pattern": "(?i)(secret|passw|passphrase|pwd|token|api_?key|(^|_)key$|dsn|private|credential)" }
        }
      },
      "then": {
        "description": "Secret-like variables must come from a Secret: valueFrom.secretKeyRef only, never a literal value or another source.",
        "required": ["valueFrom"],
        "properties": { "valueFrom": { "required": ["secretKeyRef"] } }
      }
    },
    "serviceSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "registry": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9.:-]*[a-z0-9])?(/[a-z0-9]([a-z0-9._-]*[a-z0-9])?)*$"
            },
            "repository": {
              "type": "string",
              "pattern": "^$|^[a-z0-9]([a-z0-9.:-]*[a-z0-9])?(/[a-z0-9]([a-z0-9._-]*[a-z0-9])?)*$"
            },
            "tag": { "type": "string", "pattern": "^$|^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$" },
            "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
            "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "replicas": { "type": "integer", "minimum": 1 },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/containerPort" }
        },
        "env": { "type": "array", "items": { "$ref": "#/definitions/envVar" } },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": { "$ref": "#/definitions/resourceList" },
            "limits": { "$ref": "#/definitions/resourceList" }
          }
        },
        "podSecurityContext": { "$ref": "#/definitions/podSecurityContext" },
        "securityContext": { "$ref": "#/definitions/containerSecurityContext" },
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "startup": { "$ref": "#/definitions/probe" },
            "liveness": { "$ref": "#/definitions/probe" },
            "readiness": { "$ref": "#/definitions/probe" }
          }
        },
        "credentials": {
          "description": "Dependency Secrets injected into this service only; never set in serviceDefaults.",
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["qdrant-read", "qdrant-write", "object-storage", "smtp", "ai"] }
        },
        "preStopSleepSeconds": { "type": "integer", "minimum": 0, "maximum": 60 },
        "drainSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "tmpSizeLimit": { "$ref": "#/definitions/quantity" },
        "automountServiceAccountToken": { "type": "boolean" },
        "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "affinity": { "type": "object" },
        "podLabels": {
          "description": "app.kubernetes.io/ and helm.sh/ keys and istio.io/dataplane-mode are reserved for the chart's own labels.",
          "type": "object",
          "propertyNames": { "not": { "pattern": "^(app\\.kubernetes\\.io/|helm\\.sh/|istio\\.io/dataplane-mode$)" } },
          "additionalProperties": { "type": "string" }
        },
        "podAnnotations": {
          "description": "checksum/ keys are reserved for the chart; legacy AppArmor and seccomp annotations are rejected (use the security contexts).",
          "type": "object",
          "propertyNames": {
            "not": {
              "pattern": "^(checksum/|container\\.apparmor\\.security\\.beta\\.kubernetes\\.io/|seccomp\\.security\\.alpha\\.kubernetes\\.io/|container\\.seccomp\\.security\\.alpha\\.kubernetes\\.io/)"
            }
          },
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "seccompProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["RuntimeDefault", "Localhost"] },
        "localhostProfile": { "type": "string", "minLength": 1 }
      }
    },
    "appArmorProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["RuntimeDefault", "Localhost"] },
        "localhostProfile": { "type": "string", "minLength": 1 }
      }
    },
    "seLinuxOptions": {
      "description": "Only the SELinux types and fields that the restricted Pod Security Standard allows.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["container_t", "container_init_t", "container_kvm_t", "container_engine_t"] },
        "level": { "type": "string" }
      }
    },
    "podSecurityContext": {
      "description": "Allow-list of pod security settings within the restricted Pod Security Standard.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runAsNonRoot": { "const": true },
        "runAsUser": { "type": "integer", "minimum": 1 },
        "runAsGroup": { "type": "integer", "minimum": 0 },
        "fsGroup": { "type": "integer", "minimum": 0 },
        "fsGroupChangePolicy": { "enum": ["OnRootMismatch", "Always"] },
        "supplementalGroups": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "seccompProfile": { "$ref": "#/definitions/seccompProfile" },
        "appArmorProfile": { "$ref": "#/definitions/appArmorProfile" },
        "seLinuxOptions": { "$ref": "#/definitions/seLinuxOptions" }
      }
    },
    "containerSecurityContext": {
      "description": "Allow-list of container security settings within the restricted Pod Security Standard.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowPrivilegeEscalation": { "const": false },
        "readOnlyRootFilesystem": { "type": "boolean" },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "drop": {
              "type": "array",
              "items": { "type": "string" },
              "contains": { "const": "ALL" }
            },
            "add": { "type": "array", "maxItems": 0 }
          }
        },
        "runAsNonRoot": { "const": true },
        "runAsUser": { "type": "integer", "minimum": 1 },
        "runAsGroup": { "type": "integer", "minimum": 0 },
        "procMount": { "const": "Default" },
        "seccompProfile": { "$ref": "#/definitions/seccompProfile" },
        "appArmorProfile": { "$ref": "#/definitions/appArmorProfile" },
        "seLinuxOptions": { "$ref": "#/definitions/seLinuxOptions" }
      }
    }
  }
}
