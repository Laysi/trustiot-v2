# Identity service test double for the ingress e2e test (see server.ts). Test-only image:
# build it from this directory and load it into the test cluster, never publish it.
#   podman build --platform linux/arm64 -t localhost/trustiot-e2e/identity-double:62 .
# Bun matches the version pinned in .prototools; the base is pinned by its multi-arch index digest.
FROM docker.io/oven/bun:1.4.3-distroless@sha256:1aaa515018b0b37d95dbdebd55d1b7f37ad258a6289ba63e4bc3b9c9e3038697
COPY server.ts /app/server.ts
# Numeric non-root user, as the chart's restricted Pod Security settings require.
USER 65532:65532
EXPOSE 8080 8081 8082
ENTRYPOINT ["bun", "run", "/app/server.ts"]
