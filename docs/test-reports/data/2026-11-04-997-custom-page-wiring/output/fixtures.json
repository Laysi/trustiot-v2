     "title": "Plant power",
     "spec": {
      "datasets": [
       {
        "name": "power",
        "title": "Line power",
        "description": "Line power（測試資料）",
        "max_rows": 2000,
        "source": {
         "kind": "sql",
         "sql": "SELECT ts, line, kw FROM power ORDER BY ts"
        }
       },
       {
        "name": "daily",
        "title": "Daily energy",
        "description": "Daily energy（測試資料）",
        "max_rows": 2000,
        "source": {
         "kind": "sql",
         "sql": "SELECT day, site, kwh FROM daily"
        }
       },
       {
        "name": "readings",
        "title": "Meter readings",
        "description": "Meter readings（測試資料）",
        "max_rows": 2000,
        "source": {
         "kind": "sql",
         "sql": "SELECT meter, value, online, installed, seen FROM readings"
        }
       },
       {
        "name": "trend",
        "title": "Daily total",
        "description": "Daily total（測試資料）",
        "max_rows": 2000,
        "source": {
         "kind": "sql",
         "sql": "SELECT day, kwh FROM daily_total ORDER BY day"
        }
       }
      ],
      "computations": [
       {
        "name": "total_kwh",
        "title": "Total energy",
        "formula": "sum(daily.kwh)",
        "unit": "kWh"
       },
       {
        "name": "last_week",
        "title": "Last week",
        "formula": "daily.kwh[1] * 2",
        "unit": "kWh"
       }
      ],
      "constants": [
       {
        "name": "warn",
        "title": "Warning",
        "value": 100,
        "unit": "kW"
       },
       {
        "name": "limit",
        "title": "Limit",
        "value": 1245.5,
        "unit": "kW",
        "note": "Contract demand"
       }
      ],
      "components": [
       {
        "kind": "kpi",
        "title": "Energy this week",
        "value": {
         "kind": "computation",
         "name": "total_kwh"
        },
        "compare": "last_week",
        "trend": {
         "dataset": "trend",
         "x": "day",
         "y": "kwh"
        },
        "unit": "kWh"
       },
       {
        "kind": "custom_page"
       }
      ]
     },
