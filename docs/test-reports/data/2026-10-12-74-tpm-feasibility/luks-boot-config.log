== generated unit
# /run/systemd/generator/systemd-cryptsetup@poc74data.service
# Automatically generated by systemd-cryptsetup-generator

[Unit]
Description=Cryptography Setup for %I
Documentation=man:crypttab(5) man:systemd-cryptsetup-generator(8) man:systemd-cryptsetup@.service(8)
SourcePath=/etc/crypttab

DefaultDependencies=no
After=cryptsetup-pre.target systemd-udevd-kernel.socket systemd-tpm2-setup-early.service
Before=blockdev@dev-mapper-%i.target
Wants=blockdev@dev-mapper-%i.target
IgnoreOnIsolate=true
Conflicts=umount.target
Before=umount.target
RequiresMountsFor=/var/lib/trustiot-poc74/data.luks
Wants=modprobe@loop.service
After=modprobe@loop.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutSec=infinity
KeyringMode=shared
OOMScoreAdjust=500
ImportCredential=cryptsetup.*
ExecStart=/usr/bin/systemd-cryptsetup attach 'poc74data' '/var/lib/trustiot-poc74/data.luks' 'none' 'luks,tpm2-device=auto,tpm2-measure-pcr=yes,headless=true,nofail'
ExecStop=/usr/bin/systemd-cryptsetup detach 'poc74data'

# /etc/systemd/system/systemd-cryptsetup@poc74data.service.d/poc74.conf
# Laysi/trustiot-v2#74: the SPI TPM is probed by a kernel module; wait for it rather than fail
# early, and never wait forever (the unit is nofail, so boot does not depend on it).
[Unit]
Wants=dev-tpmrm0.device
After=dev-tpmrm0.device
[Service]
TimeoutStartSec=120
