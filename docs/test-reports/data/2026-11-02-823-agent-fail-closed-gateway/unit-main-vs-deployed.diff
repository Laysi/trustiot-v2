--- edge/agent/systemd/trustiot-agent.service (main 2e882e56)
+++ /usr/lib/systemd/system/trustiot-agent.service (lab gateway, built from 32a5cd92)
@@ -2,8 +2,7 @@
 # Installed as /usr/lib/systemd/system/trustiot-agent.service, with the executable at
 # /usr/bin/trustiot-agent and the account from trustiot-agent.sysusers
 # (/usr/lib/sysusers.d/trustiot-agent.conf). The TPM's /dev/tpmrm0 belongs to the group tss
-# (Debian's tpm-udev), which must exist before the service starts. It requires
-# trustiot-agent-egress.service, installed with it.
+# (Debian's tpm-udev), which must exist before the service starts.
 
 [Unit]
 Description=TrustIoT gateway agent
@@ -11,34 +10,12 @@
 # Not network-online.target: a site without network must not delay boot, and the agent retries
 # on its own (it reports READY=1 before its first connection).
 After=network.target
-# The kernel-level egress rules for this account are in force before the agent starts. When they
-# cannot be loaded, the agent does not start (fail closed); when that unit is stopped or
-# restarted, so is the agent (edge/agent/README.md, section "systemd"). ExecStartPre= below loads
-# them again before every start of this unit.
-Requires=trustiot-agent-egress.service
-After=trustiot-agent-egress.service
-# While the agent runs, a check loads the rules again within 11 s when they were flushed outside
-# systemd, or restarts the agent when they do not load (Laysi/trustiot-v2#878). The timer starts
-# after the agent and stops and restarts with it (its PartOf=), and runs on while the agent
-# restarts after a crash. Wants=, not Requires=: with Requires= the timer's restart would restart
-# the agent once more within every automatic restart, which resets the restart counter and with
-# it the growing delay of RestartSteps= (tests/egress.rs counts the restarts).
-Wants=trustiot-agent-egress-check.timer
 # An unattended gateway never gives up restarting.
 StartLimitIntervalSec=0
 
 [Service]
 Type=notify
 NotifyAccess=main
-# Every start, the automatic restarts included, loads the egress rules again before the agent's
-# process runs: a `nft flush ruleset` by root outside systemd leaves trustiot-agent-egress.service
-# active, so without this line a restarted agent would run without its rules. The file replaces
-# only its own table, in one transaction, so a load where the rules are already in force changes
-# nothing but the counters. When it fails, the agent does not run (no "-" prefix), and
-# Restart=always tries the whole start again later. "+" runs only this command as root without the
-# sandbox below (nft needs CAP_NET_ADMIN and netlink); the agent's own process keeps the account,
-# the empty capability sets and the sandbox (edge/agent/README.md, section "systemd").
-ExecStartPre=+/usr/sbin/nft -f /usr/share/trustiot-agent/trustiot-agent-egress.nft
 ExecStart=/usr/bin/trustiot-agent --config /etc/trustiot/agent.toml
 Restart=always
 RestartSec=2s
@@ -70,14 +47,6 @@
 ProtectSystem=strict
 ProtectHome=yes
 PrivateTmp=yes
-# The agent uses neither D-Bus nor avahi nor the local sshd. Through the first two it could ask
-# avahi, directly or over the system bus, to send mDNS on the LAN for it, outside its egress rules;
-# through sshd's unix socket (systemd's ssh generator), with a key it writes to its own home, it
-# could open a session outside this sandbox and reach both (edge/agent/README.md, section
-# "這一層擋不到的"). The directories, not the socket files: a socket unit replaces its file when it
-# starts again, and the new file would not be hidden. "-": a gateway without them starts the
-# agent all the same.
-InaccessiblePaths=-/run/dbus -/run/avahi-daemon -/run/ssh-unix-local
 PrivateIPC=yes
 RemoveIPC=yes
 # Not PrivateDevices=, which would hide the TPM; only the TPM resource manager is allowed.
@@ -89,22 +58,11 @@
 ProtectControlGroups=yes
 ProtectClock=yes
 ProtectHostname=yes
-# Not ProcSubset=pid: the heartbeat reads /proc/meminfo, /proc/uptime and /proc/stat (src/host.rs).
+# Not ProcSubset=pid: the heartbeat reads /proc/meminfo and /proc/uptime.
 ProtectProc=invisible
 # AF_NETLINK: the Modbus address guard reads the gateway's interface addresses with
 # getifaddrs, which opens a netlink socket; without it every Modbus connection is refused.
 RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
-# Refusals that do not depend on nftables (Laysi/trustiot-v2#878): systemd attaches them to this
-# unit's cgroup as BPF programs, so they hold while the egress rules are flushed and until the
-# check loads them again. Only destinations that can be named in advance and that the agent never
-# needs: loopback, 0.0.0.0/8 (the kernel sends a connection to 0.0.0.0 to loopback), multicast,
-# the limited broadcast address and the two metadata addresses. Not the gateway's own interface
-# addresses, subnet broadcasts and anycast addresses, which change with the network, and not
-# link-local as a whole: field devices use APIPA addresses and a router may announce a link-local
-# DNS server (edge/agent/README.md, section "systemd"). They apply both ways: to the destination of
-# what the agent sends and to the source of what it receives. No IPAddressAllow=, which would
-# take precedence over them.
-IPAddressDeny=localhost 0.0.0.0/8 multicast 255.255.255.255/32 169.254.169.254/32 fd00:ec2::254/128
 RestrictNamespaces=yes
 RestrictRealtime=yes
 RestrictSUIDSGID=yes
